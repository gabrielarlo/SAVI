# LocalRAG Configuration

# Backend Port
PORT=8080

# Database Connection (SQLite)
DATABASE_URL=sqlite://data/local_rag.db

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333

# External Ollama Service
# If running on macOS/Windows host and app is in Docker, use: http://host.docker.internal:11434
# If running both locally: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# Environment
ENV=local

# Security (optional)
# ADMIN_SECRET=secret_admin_key

# Optional: seed a default administrator on first startup (leave blank to skip)
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=change-me-8chars

# Chatbot persona name (used as the assistant's name in responses)
# CODE_NAME=SAVI

# Company name the assistant represents
# COMPANY_NAME=Your Company

# Chat model used for inquiry answers (Ollama)
# CHAT_MODEL=llama3.2:3b

# Application branding (admin console)
APP_NAME=LocalRAG
APP_SHORT_DESCRIPTION=
